.somi
# Local Claude settings stay untracked; repo skills are shared.
.claude/*
!.claude/skills/
__pycache__/
*.pyc
# A hook outside this repo writes here when it does not expand the variable; local paths, never commit.
/${CLAUDE_PROJECT_DIR}/
# tests/pages-site/build-site.js writes hashira's Pages site here for a local look; nothing
# generated is committed.
/artifacts/

# Browser snapshots and console logs a Playwright MCP session writes; local only, never commit.
/.playwright-mcp/
