<?xml version="1.0" encoding="utf-8"?>
<!--
  Read only by the publish job's nuget-push step, which runs in this
  directory (working_directory: feed). The throwaway BaGetter feed is plain
  HTTP on localhost, and NuGet refuses to push to an HTTP source unless a
  config file names it with allowInsecureConnections. This file sits in its
  own directory so the CI jobs' restore at the repository root never sees a
  feed that only exists inside the publish job.
-->
<configuration>
  <packageSources>
    <add key="fixture-feed" value="http://localhost:5555/v3/index.json" allowInsecureConnections="true" />
  </packageSources>
</configuration>
